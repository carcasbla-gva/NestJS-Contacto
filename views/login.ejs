<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/estilos.css">
    <script src="/js/theme.js"></script>
    <title>Iniciar Sesión - Agenda</title>
</head>
<body>
    <!-- Botón flotante de tema -->
    <div class="theme-toggle-floating">
        <button type="button" class="btn-theme-toggle" onclick="toggleTheme()" title="Cambiar tema">
            <span class="theme-toggle-icon"></span>
        </button>
    </div>

    <div class="auth-wrapper">
        <div class="auth-card">
            <div class="auth-header">
                <div class="auth-badge-icon">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                        <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                </div>
                <h1 style="font-size: 1.5rem; font-weight: 800; color: var(--text-main); margin-bottom: 4px;">Agenda</h1>
                <p style="font-size: 0.88rem; color: var(--text-muted);">Inicia sesión para gestionar tus contactos</p>
            </div>

            <!-- Pestañas para cambiar fácilmente de ruta sin usar URL -->
            <div class="auth-tabs">
                <a href="/login" class="auth-tab active">Iniciar Sesión</a>
                <a href="/registro" class="auth-tab">Crear Cuenta</a>
            </div>

            <div class="auth-body">
                <% if (error) { %>
                    <div class="alert alert-error">
                        <span><%= error %></span>
                    </div>
                <% } %>

                <% if (exito) { %>
                    <div class="alert alert-success">
                        <span><%= exito %></span>
                    </div>
                <% } %>

                <form action="/login" method="POST" style="padding: 0; box-shadow: none; background: transparent;">
                    <div class="form-group">
                        <label for="username">Nombre de Usuario</label>
                        <input type="text" id="username" name="username" class="form-control" placeholder="Introduce tu usuario" required autofocus>
                    </div>

                    <div class="form-group">
                        <label for="password">Contraseña</label>
                        <input type="password" id="password" name="password" class="form-control" placeholder="Introduce tu contraseña" required>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block" style="margin-top: 20px;">
                        Entrar a mi Agenda
                    </button>
                </form>
            </div>

            <div class="auth-footer">
                ¿No tienes una cuenta? <a href="/registro">Regístrate aquí gratis</a>
            </div>
        </div>
    </div>
</body>
</html>
