<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/estilos.css">
    <script src="/js/theme.js"></script>
    <title>Editar Contacto - Agenda</title>
</head>
<body>
    <!-- Navbar Global -->
    <nav class="main-navbar">
        <div class="nav-container">
            <a href="/contactos" class="brand-logo">
                <span class="brand-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                        <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                </span>
                <span>Agenda</span>
            </a>
            
            <div class="nav-links">
                <a href="/contactos" class="nav-link">Contactos</a>
                <a href="/contactos/nuevo" class="nav-link">+ Nuevo</a>

                <!-- Botón Modo Oscuro / Claro -->
                <button type="button" class="btn-theme-toggle" onclick="toggleTheme()" title="Cambiar tema">
                    <span class="theme-toggle-icon"></span>
                </button>

                <% if (typeof user !== 'undefined' && user) { %>
                    <div class="user-profile-pill">
                        <span class="user-avatar-sm"><%= (user.nombre || user.username || 'U').charAt(0) %></span>
                        <span class="user-name-text"><%= user.nombre || user.username %></span>
                    </div>
                <% } %>
                
                <a href="/logout" class="btn-logout" title="Cerrar sesión">Cerrar Sesión</a>
            </div>
        </div>
    </nav>

    <!-- Contenido Principal -->
    <main class="main-content">
        <div class="breadcrumb-bar">
            <a href="/contactos" class="btn btn-secondary btn-sm">
                Volver a Contactos
            </a>
        </div>

        <div class="form-card">
            <div class="form-header">
                <h2 style="font-size: 1.3rem; font-weight: 700; color: var(--text-main);">Editar Contacto #<%= contacto.id %></h2>
                <p style="font-size: 0.88rem; color: var(--text-muted); margin-top: 4px;">Modifica los datos del contacto y guarda los cambios.</p>
            </div>

            <form action="/contactos/editar/<%= contacto.id %>" method="POST" class="form-body">
                <div class="form-group">
                    <label for="nombre">Nombre *</label>
                    <input type="text" id="nombre" name="nombre" class="form-control" value="<%= contacto.nombre %>" required autofocus>
                </div>

                <div class="form-group">
                    <label for="apellidos">Apellidos *</label>
                    <input type="text" id="apellidos" name="apellidos" class="form-control" value="<%= contacto.apellidos %>" required>
                </div>

                <div class="form-group">
                    <label for="telefono">Teléfono *</label>
                    <input type="text" id="telefono" name="telefono" class="form-control" value="<%= contacto.telefono %>" required>
                </div>

                <div class="form-group">
                    <label for="email">Correo Electrónico *</label>
                    <input type="email" id="email" name="email" class="form-control" value="<%= contacto.email %>" required>
                </div>

                <div class="form-group">
                    <label for="provincia">Provincia</label>
                    <input type="text" id="provincia" name="provincia" class="form-control" value="<%= contacto.provincia || '' %>" placeholder="Ej: Valencia, Madrid, Barcelona...">
                </div>

                <div class="form-group">
                    <label for="pais">País</label>
                    <input type="text" id="pais" name="pais" class="form-control" value="<%= contacto.pais || '' %>" placeholder="Ej: España, Francia, México...">
                </div>

                <div class="form-actions">
                    <a href="/contactos" class="btn btn-secondary">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary">
                        Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </main>
</body>
</html>