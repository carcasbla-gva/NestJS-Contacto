<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/css/estilos.css">
    <title>Editar Contacto</title>
</head>
<body>
    <h1>Editar Contacto</h1>
    <a href="/contactos" style="display:inline-block; margin-bottom: 20px;">Volver a la lista</a>

    <!-- La acción apunta a la ruta de actualizar pasando el ID -->
    <form action="/contactos/editar/<%= contacto.id %>" method="POST">
        <label>Nombre:</label><br>
        <input type="text" name="nombre" value="<%= contacto.nombre %>" required><br><br>
        
        <label>Apellidos:</label><br>
        <input type="text" name="apellidos" value="<%= contacto.apellidos %>" required><br><br>
        
        <label>Teléfono:</label><br>
        <input type="text" name="telefono" value="<%= contacto.telefono %>" required><br><br>
        
        <label>Email:</label><br>
        <input type="email" name="email" value="<%= contacto.email %>" required><br><br>
        
        <button type="submit">Actualizar Contacto</button>
    </form>
</body>
</html>